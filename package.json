{
  "name": "splicing-planning-assistant",
  "version": "0.20.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:hosted": "node tests/hosted.mjs",
    "check": "node --check server.mjs && node --check public/workflow-ui.js && node --check lib/workflow-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "playwright": "^1.63.0"
  }
}
